<Window x:Class="BlueRelay.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置" Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterScreen" Topmost="True"
        Background="Transparent" AllowsTransparency="True">

    <Window.Resources>
        <!-- iOS 风格开关 -->
        <Style x:Key="ToggleSwitch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource FgBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="track" Width="46" Height="28" CornerRadius="14"
                                    Background="{DynamicResource SliderTrackBrush}" VerticalAlignment="Center">
                                <Ellipse x:Name="knob" Width="24" Height="24" Fill="{DynamicResource SliderThumbBrush}"
                                         HorizontalAlignment="Left" Margin="2"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="12">
        <Border Background="{DynamicResource BgBrush}" CornerRadius="14" Padding="20"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.4" Color="#000000"/>
            </Border.Effect>
            <StackPanel>
                <!-- 标题 -->
                <Grid Margin="0,0,0,18">
                    <TextBlock Text="设置" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource FgBrush}"/>
                    <TextBlock Text="此电脑的偏好设置" FontSize="11" Foreground="{DynamicResource SecondaryFgBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Grid>

                <!-- 外观 -->
                <TextBlock Text="外观" FontSize="11" Foreground="{DynamicResource SecondaryFgBrush}" Margin="2,0,0,8"/>
                <CheckBox Content="深色模式" IsChecked="{Binding DarkTheme}" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,18"/>

                <!-- 启动 -->
                <TextBlock Text="启动" FontSize="11" Foreground="{DynamicResource SecondaryFgBrush}" Margin="2,0,0,8"/>
                <StackPanel>
                    <CheckBox Content="开机自启" IsChecked="{Binding AutoStart}" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,12"/>
                    <CheckBox Content="启动时自动连接" IsChecked="{Binding AutoConnectOnStart}" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,4"/>
                    <TextBlock Text="启动时自动连接上次使用的设备" FontSize="11" Foreground="{DynamicResource SecondaryFgBrush}" Margin="58,0,0,12"/>
                    <CheckBox Content="自动重连" IsChecked="{Binding AutoReconnect}" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,4"/>
                    <TextBlock Text="连接意外断开后自动重连" FontSize="11" Foreground="{DynamicResource SecondaryFgBrush}" Margin="58,0,0,18"/>
                </StackPanel>

                <!-- 连接 -->
                <TextBlock Text="连接" FontSize="11" Foreground="{DynamicResource SecondaryFgBrush}" Margin="2,0,0,8"/>
                <StackPanel>
                    <CheckBox Content="自动修复无声" IsChecked="{Binding AutoRepairNoSound}" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,4"/>
                    <TextBlock Text="连接后 10 秒完全没有声音时，自动断开重连一次" FontSize="11" Foreground="{DynamicResource SecondaryFgBrush}" Margin="58,0,0,12"/>
                    <CheckBox Content="仅监听模式" IsChecked="{Binding ListenOnlyMode}" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,4"/>
                    <TextBlock Text="只等待、由手机发起连接，解决「已连接但无声」" FontSize="11" Foreground="{DynamicResource SecondaryFgBrush}" Margin="58,0,0,12"/>
                    <CheckBox Content="音频稳定模式" IsChecked="{Binding AudioPerformanceBoost}" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,4"/>
                    <TextBlock Text="连接期间启用 Pro Audio 调度，减少卡顿（下次连接生效）" FontSize="11" Foreground="{DynamicResource SecondaryFgBrush}" Margin="58,0,0,18"/>
                </StackPanel>

                <!-- 蓝牙质量 -->
                <TextBlock Text="蓝牙质量" FontSize="11" Foreground="{DynamicResource SecondaryFgBrush}" Margin="2,0,0,8"/>
                <StackPanel>
                    <CheckBox Content="低端硬件模式" IsChecked="{Binding LowEndMode}" Style="{StaticResource ToggleSwitch}" Margin="0,0,0,4"/>
                    <TextBlock Text="弱信号下稳定音频，需要管理员权限" FontSize="11" Foreground="{DynamicResource SecondaryFgBrush}" Margin="58,0,0,18"/>
                </StackPanel>

                <!-- 底部 -->
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,4,0,16"/>
                <Grid>
                    <TextBlock Text="设置即时保存" FontSize="11" Foreground="{DynamicResource SecondaryFgBrush}" VerticalAlignment="Center"/>
                    <Button Content="关闭" HorizontalAlignment="Right" Padding="20,8" Cursor="Hand" Click="Close_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="14"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.82"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</Window>
